APP_NAME=Comments
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Host ports published by Docker Compose (development only).
APP_HTTP_PORT=8080
VITE_PORT=5173
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
REVERB_HOST_PORT=8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=comments
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:5173,127.0.0.1,127.0.0.1:8080,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_IMAGE_MAX_MB=10
IMAGE_DRIVER=imagick
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

COMMENT_RATE_LIMIT=10
COMMENT_RATE_LIMIT_DECAY=1
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_LIMIT_DECAY=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_DECAY=1
PASSWORD_RECOVERY_RATE_LIMIT=3
PASSWORD_RECOVERY_RATE_LIMIT_DECAY=15

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

REVERB_APP_ID=comments
# Local development credentials only; replace outside the local environment.
REVERB_APP_KEY=comments-local-key
REVERB_APP_SECRET=comments-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
