# Copy to .env.production on the server and replace every placeholder.
APP_NAME=Comments
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_HOST=comments.example.com
APP_URL=https://comments.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=comments
DB_USERNAME=comments
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=comments.example.com
SANCTUM_STATEFUL_DOMAINS=comments.example.com
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
COMMENTS_CACHE_TTL=60

QUEUE_CONNECTION=rabbitmq
BROADCAST_CONNECTION=reverb
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=comments
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
RABBITMQ_VHOST=/

REVERB_APP_ID=comments
REVERB_APP_KEY=replace-with-a-random-public-app-key
REVERB_APP_SECRET=replace-with-a-long-random-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
MEDIA_IMAGE_MAX_MB=10
IMAGE_DRIVER=imagick
NOCAPTCHA_SITEKEY=replace-with-production-recaptcha-v2-site-key
NOCAPTCHA_SECRET=replace-with-production-recaptcha-v2-secret

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS=comments@example.com
MAIL_FROM_NAME=Comments

COMMENT_RATE_LIMIT=10
COMMENT_RATE_LIMIT_DECAY=1
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_LIMIT_DECAY=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_DECAY=1
PASSWORD_RECOVERY_RATE_LIMIT=3
PASSWORD_RECOVERY_RATE_LIMIT_DECAY=15

# Docker image build settings. Vite embeds these values in public assets.
HTTP_PORT=8080
IMAGE_TAG=production
